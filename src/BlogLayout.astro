---
import Layout from "./Layout.astro";
import type { MarkdownLayoutProps } from "astro";

type Props = MarkdownLayoutProps<{
  title: string;
  date: string;
  description: string;
}>;

const { frontmatter } = Astro.props;
const site = Astro.site;
const postDescription = frontmatter.description;
const postUrl = new URL(Astro.url.pathname, site).toString();

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: frontmatter.title,
  description: postDescription,
  datePublished: frontmatter.date,
  author: {
    "@type": "Person",
    name: "Kostas Koukos",
    url: site,
  },
  mainEntityOfPage: postUrl,
  image: new URL("/favicon.svg", site).toString(),
};
---

<Layout
  title={`${frontmatter.title} | Kostas Koukos`}
  description={postDescription}
  canonical={postUrl}
  ogType="article"
  structuredData={structuredData}
>
  <article
    class="prose prose-theme prose-a:no-underline prose-a:link prose-sm md:prose-base lg:prose-lg mx-auto"
  >
    <span class="text-xs md:text-sm text-foreground/50"
      >{
        new Date(frontmatter.date).toLocaleDateString(undefined, {
          dateStyle: "medium",
        })
      }</span
    >
    <div class="m-1 text-center">
      <h1
        class="inline p-1 text-lg md:text-2xl lg:text-3xl bg-foreground text-background font-black tracking-tight"
      >
        {frontmatter.title}
      </h1>
    </div>
    <slot />
  </article>
</Layout>
