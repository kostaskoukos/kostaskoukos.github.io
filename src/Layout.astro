---
import "./global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = "Kostas Koukos' personal portfolio website with a short summary, projects, blog posts and contact information.",
  canonical,
  ogType = "website",
  structuredData,
} = Astro.props as Props;

const site = Astro.site;
const pageTitle = title ?? (import.meta.env.DEV ? "Local" : "Kostas Koukos");
const pageUrl = new URL(canonical || Astro.url.pathname, site).toString();
const socialImage = new URL("/favicon.svg", site).toString();
const structuredDataJson = structuredData && JSON.stringify(structuredData);
---

<!doctype html>
<html lang="en">
  <head>
    <meta
      name="google-site-verification"
      content="Wtg-PRJZos3BA5zUi63WQZuEAF0PsHnCOdX1cBmtWV4"
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/JetBrainsMono.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {
      structuredDataJson && (
        <script type="application/ld+json" set:html={structuredDataJson} />
      )
    }
    <script is:inline>
      const getTheme = () => {
        if (localStorage.getItem("theme")) return localStorage.getItem("theme");

        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };
      if (getTheme() == "dark") document.documentElement.classList.add("dark");
    </script>
  </head>
  <body class="max-w-full font-mono bg-background text-foreground px-4">
    <header
      class="max-w-3xl mx-auto flex items-center justify-between py-4 border-b border-dotted"
    >
      <nav>
        <ul class="flex align-center gap-2">
          <li>
            <a
              href="/#home"
              class="p-2 text-sm md:text-base bg-background text-foreground hover:text-background hover:bg-foreground active:text-background active:bg-foreground"
              >Home</a
            >
          </li>
          <li>
            <a
              href="/#projects"
              class="p-2 text-sm md:text-base bg-background text-foreground hover:text-background hover:bg-foreground active:text-background active:bg-foreground"
              >Projects</a
            >
          </li>
          <li>
            <a
              href="/#blog"
              class="p-2 text-sm md:text-base bg-background text-foreground hover:text-background hover:bg-foreground active:text-background active:bg-foreground"
              >Blog</a
            >
          </li>
          <li>
            <a
              href="/#contact"
              class="p-2 text-sm md:text-base bg-background text-foreground hover:text-background hover:bg-foreground active:text-background active:bg-foreground"
              >Contact</a
            >
          </li>
        </ul>
      </nav>
      <button
        aria-label="Toggle theme"
        id="theme"
        class="relative inline-flex size-8 cursor-pointer items-center justify-center rounded-full border border-foreground/60 bg-background hover:bg-surface active:scale-95"
      >
        <span aria-hidden="true" class="size-3 rounded-full bg-foreground"
        ></span>
      </button>
      <script>
        const doc = document.documentElement;
        doc.querySelector("#theme")?.addEventListener("click", () => {
          const isDark = doc.classList.toggle("dark");
          localStorage.setItem("theme", isDark ? "dark" : "light");
        });
      </script>
    </header>
    <main class="max-w-3xl mx-auto py-5 space-y-15">
      <slot />
    </main>
  </body>
</html>
